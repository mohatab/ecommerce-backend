# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL connection string used by Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_dev

# CORS
CORS_ORIGIN=*

# Test database (used by the e2e harness only, never by the running app)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce_test

# Authentication
# JWT_SECRET must be at least 32 characters; boot aborts otherwise.
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Admin bootstrap (optional; read only by the bootstrap script, never by the API)
# Run after building:  node dist/scripts/bootstrap-admin.js
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-after-first-login

# Payments (Phase 4)
# PAYMENT_PROVIDER selects the adapter: `stripe` or `fake`.
# `fake` is a real, DI-selected implementation for local development and the
# e2e suite. Boot ABORTS if it is used with NODE_ENV=production.
PAYMENT_PROVIDER=fake
# Required only when PAYMENT_PROVIDER=stripe. Use a test-mode key. Leave it
# commented out while the provider is `fake`: Joi's string rule rejects an
# empty value, so `PAYMENT_API_KEY=` with nothing after it aborts boot.
# PAYMENT_API_KEY=sk_test_replace_me
# Webhook HMAC secret, used by whichever adapter is selected. At least 16
# characters; boot aborts if it is missing or empty.
PAYMENT_WEBHOOK_SECRET=change-me-to-a-random-webhook-signing-secret
# Provider HTTP call timeout, in milliseconds. Floor 1000.
PAYMENT_PROVIDER_TIMEOUT_MS=10000

# Scheduled maintenance (Phase 5)
# Master switch for every cron job. Opt-out: only the literal `false`
# disables them, so a deployment that omits the variable still runs them.
MAINTENANCE_JOBS_ENABLED=true
# All cron expressions are 6-field (@nestjs/schedule), seconds first.
# Order expiry sweep: every 5 minutes.
ORDER_EXPIRY_CRON=0 */5 * * * *
# How long an unpaid order stays claimable. Floor 1: a TTL of 0 would stamp
# expiresAt = now() at checkout and expire every order at creation.
ORDER_EXPIRY_TTL_MINUTES=30
# Longer grace once a payment has been started, so a slow provider does not
# lose a customer their order.
ORDER_EXPIRY_PAYMENT_STARTED_TTL_HOURS=24
# Orders per expiry tick. Capped at 1000 to bound one tick's work.
ORDER_EXPIRY_BATCH_SIZE=100
# Retention purge: daily at 03:00.
MAINTENANCE_PURGE_CRON=0 0 3 * * *
# Rows deleted per purge statement. Capped at 10000.
MAINTENANCE_PURGE_BATCH_SIZE=1000
# Floor 7, which equals JWT_REFRESH_TTL. Below it the purge deletes LIVE tokens.
REFRESH_TOKEN_RETENTION_DAYS=30
# Floor 30. payment_events is the webhook idempotency ledger: deleting a row
# makes a pre-cutoff replay newly processable.
PAYMENT_EVENT_RETENTION_DAYS=90
# Payment reconciliation sweep: every 15 minutes.
RECONCILE_CRON=0 */15 * * * *
# Minimum order age before reconciliation looks at it. Floor 6 minutes, which
# must exceed the webhook timestamp tolerance (300s), or an in-flight payment
# is reported as divergent.
RECONCILE_MIN_AGE_MINUTES=15
# How far back reconciliation looks.
RECONCILE_LOOKBACK_DAYS=30
# Orders per reconciliation tick. Capped at 1000.
RECONCILE_BATCH_SIZE=100
# Consecutive provider precheck failures before the pass gives up.
RECONCILE_PRECHECK_FAILURE_THRESHOLD=3
# Maintenance lease duration. Floor 30s. The heartbeat renews at a third of
# this, so the lease cannot lapse under its own live holder at any value; what
# the floor bounds is the other direction — a lapsed lease is the only way a
# crashed holder's job recovers, and a very short lease spends the tick
# renewing instead of working.
MAINTENANCE_LEASE_SECONDS=300
